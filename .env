# Redis clone local runtime config.
#
# Run with:
#   go run ./cmd
#
# Memory limit in bytes. Set 0 or leave empty to disable the limit.
MAXMEMORY=10485760
# MAXMEMORY=1897 in order to test eviction policy with seeding data from main_test.go

# Supported policies:
#   noeviction
#   allkeys-lru
#   volatile-lru
#   allkeys-lfu
#   allkeys-random
MAXMEMORY_POLICY=allkeys-lru
